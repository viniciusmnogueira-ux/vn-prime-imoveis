/* ─── ESTILOS ───────────────────────────────────────────────── */
const css = `
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Outfit:wght@300;400;500;600;700&display=swap');
  *{box-sizing:border-box;margin:0;padding:0;}
  body{background:${C.bg};font-family:'Outfit',sans-serif;color:${C.text};min-height:100vh;}
  ::-webkit-scrollbar{width:4px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{background:${C.navyMid};border-radius:4px;}
`;

/* ─── APP ───────────────────────────────────────────────────── */
export default function App() {
  const [persona, setPersona] = useState("corretor"); // corretor | vendedor
  const [etapaIdx, setEtapaIdx] = useState(0);
  const [canal, setCanal] = useState("whatsapp");
  const [showObjecao, setShowObjecao] = useState(null);
  const [copied, setCopied] = useState(false);

  const funil = persona === "corretor" ? FUNIL_CORRETOR : FUNIL_VENDEDOR;
  const etapa = funil[etapaIdx];
  const script = etapa?.scripts?.[canal];

  const canais = [
    { key: "whatsapp", label: "WhatsApp", emoji: "💬" },
    { key: "portal", label: "Portal / Site", emoji: "🖥️" },
    { key: "indicacao", label: "Indicação", emoji: "🤝" },
    { key: "email", label: "E-mail", emoji: "✉️" },
  ];

  const handleCopy = () => {
    if (!script) return;
    navigator.clipboard.writeText(script.texto);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const handleWpp = () => {
    if (!script) return;
    window.open(`https://wa.me/?text=${encodeURIComponent(script.texto)}`, "_blank");
  };

  return (
    <>
      <style>{css}</style>
      <div style={{ minHeight: "100vh", background: `linear-gradient(160deg, #07111f 0%, ${C.bg} 50%, #0c1a30 100%)` }}>

        {/* HEADER */}
        <div style={{ borderBottom: `1px solid ${C.goldBorder}`, background: "rgba(9,21,42,0.95)", backdropFilter: "blur(20px)", padding: "14px 24px", display: "flex", alignItems: "center", justifyContent: "space-between", position: "sticky", top: 0, zIndex: 100 }}>
          <div style={{ display: "flex", alignItems: "center", gap: 12 }}>
            <div style={{ width: 34, height: 34, borderRadius: 8, background: `linear-gradient(135deg, ${C.gold}, ${C.goldLight})`, display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "'Cormorant Garamond',serif", fontWeight: 700, fontSize: 15, color: "#0a1628" }}>VN</div>
            <div>
              <div style={{ fontFamily: "'Cormorant Garamond',serif", fontWeight: 600, fontSize: 16, color: "#fff", letterSpacing: 0.3 }}>VN Prime Imóveis</div>
              <div style={{ fontSize: 10, color: C.gold, fontWeight: 600, letterSpacing: 1.5, textTransform: "uppercase" }}>Scripts de Venda Consultiva</div>
            </div>
          </div>
          <div style={{ display: "flex", gap: 6 }}>
            {["corretor","vendedor"].map(p => (
              <button key={p} onClick={() => { setPersona(p); setEtapaIdx(0); setShowObjecao(null); }} style={{ padding: "7px 16px", borderRadius: 8, border: persona === p ? `1px solid ${C.goldBorder}` : `1px solid ${C.border}`, background: persona === p ? C.goldPale : "transparent", color: persona === p ? C.goldLight : C.muted, fontSize: 12, fontWeight: 600, cursor: "pointer", fontFamily: "'Outfit',sans-serif", textTransform: "capitalize", transition: "all .2s" }}>
                {p === "corretor" ? "🏢 Corretor" : "🏡 Vendedor"}
              </button>
            ))}
          </div>
        </div>

        <div style={{ display: "flex", height: "calc(100vh - 61px)" }}>

          {/* SIDEBAR — ETAPAS */}
          <div style={{ width: 220, flexShrink: 0, borderRight: `1px solid ${C.border}`, overflowY: "auto", padding: "16px 12px", display: "flex", flexDirection: "column", gap: 4 }}>
            <div style={{ fontSize: 10, fontWeight: 700, color: C.muted, letterSpacing: 1.2, textTransform: "uppercase", padding: "0 6px 10px" }}>Funil de Vendas</div>
            {funil.map((e, i) => (
              <button key={e.id} onClick={() => { setEtapaIdx(i); setShowObjecao(null); }} style={{ display: "flex", alignItems: "center", gap: 10, padding: "10px 10px", borderRadius: 9, border: etapaIdx === i ? `1px solid ${C.goldBorder}` : "1px solid transparent", background: etapaIdx === i ? C.goldPale : "transparent", cursor: "pointer", textAlign: "left", transition: "all .18s", width: "100%" }}>
                <div style={{ width: 26, height: 26, borderRadius: 6, background: etapaIdx === i ? C.gold : C.navyLight, display: "flex", alignItems: "center", justifyContent: "center", fontSize: 13, flexShrink: 0 }}>{e.icon}</div>
                <div>
                  <div style={{ fontSize: 11, fontWeight: 600, color: etapaIdx === i ? C.goldLight : C.sub, lineHeight: 1.3 }}>{e.etapa}</div>
                  <div style={{ fontSize: 10, color: C.muted, marginTop: 1 }}>{e.num}</div>
                </div>
              </button>
            ))}
          </div>

          {/* MAIN */}
          <div style={{ flex: 1, overflowY: "auto", padding: "28px 32px" }}>

            {/* CABEÇALHO DA ETAPA */}
            <div style={{ marginBottom: 24 }}>
              <div style={{ display: "flex", alignItems: "center", gap: 10, marginBottom: 8 }}>
                <span style={{ fontSize: 22 }}>{etapa.icon}</span>
                <div>
                  <div style={{ fontFamily: "'Cormorant Garamond',serif", fontSize: 22, fontWeight: 600, color: "#fff", letterSpacing: 0.3 }}>{etapa.etapa}</div>
                  <div style={{ fontSize: 11, color: C.muted, marginTop: 2 }}>Gatilho: {etapa.gatilho}</div>
                </div>
              </div>
              <div style={{ background: C.navyLight, border: `1px solid ${C.border}`, borderLeft: `3px solid ${C.gold}`, borderRadius: 8, padding: "10px 14px", fontSize: 12, color: C.sub }}>
                🎯 <strong style={{ color: C.goldLight }}>Objetivo:</strong> {etapa.objetivo}
              </div>
            </div>

            {/* TÉCNICAS USADAS */}
            <div style={{ display: "flex", flexWrap: "wrap", gap: 6, marginBottom: 22 }}>
              {etapa.tecnicas.map(t => {
                const tec = TECNICAS[t];
                return (
                  <div key={t} style={{ padding: "4px 12px", borderRadius: 20, background: `${tec.color}15`, border: `1px solid ${tec.color}35`, fontSize: 11, fontWeight: 600, color: tec.color }}>
                    {tec.label}
                  </div>
                );
              })}
            </div>

            {/* SELETOR DE CANAL */}
            <div style={{ display: "flex", gap: 6, marginBottom: 20, background: "rgba(27,58,107,0.15)", border: `1px solid ${C.border}`, borderRadius: 12, padding: 5 }}>
              {canais.map(c => (
                <button key={c.key} onClick={() => setCanal(c.key)} style={{ flex: 1, padding: "8px 6px", borderRadius: 8, border: canal === c.key ? `1px solid ${C.goldBorder}` : "1px solid transparent", background: canal === c.key ? C.goldPale : "transparent", color: canal === c.key ? C.goldLight : C.muted, fontSize: 12, fontWeight: 600, cursor: "pointer", fontFamily: "'Outfit',sans-serif", display: "flex", alignItems: "center", justifyContent: "center", gap: 4, transition: "all .18s" }}>
                  {c.emoji} {c.label}
                </button>
              ))}
            </div>

            {/* SCRIPT */}
            {script && (
              <div style={{ background: "rgba(27,58,107,0.12)", border: `1px solid ${C.border}`, borderRadius: 14, overflow: "hidden", marginBottom: 20 }}>
                {/* técnica badge */}
                <div style={{ background: `${TECNICAS[script.tecnica]?.color}12`, borderBottom: `1px solid ${C.border}`, padding: "10px 18px", display: "flex", alignItems: "center", justifyContent: "space-between" }}>
                  <div style={{ fontSize: 11, fontWeight: 600, color: TECNICAS[script.tecnica]?.color }}>
                    ✦ Técnica: {TECNICAS[script.tecnica]?.label} — {TECNICAS[script.tecnica]?.desc}
                  </div>
                </div>

                {/* texto do script */}
                <div style={{ padding: "20px 22px", fontFamily: "'Outfit',sans-serif", fontSize: 13.5, lineHeight: 1.85, color: C.sub, whiteSpace: "pre-wrap", wordBreak: "break-word" }}>
                  {script.texto}
                </div>

                {/* nota de diretor */}
                <div style={{ background: "rgba(201,150,14,0.06)", borderTop: `1px solid ${C.goldBorder}`, padding: "12px 18px", fontSize: 11.5, color: "rgba(232,210,120,0.8)", lineHeight: 1.6 }}>
                  📌 <em>{script.nota}</em>
                </div>

                {/* ações */}
                <div style={{ padding: "12px 18px", borderTop: `1px solid ${C.border}`, display: "flex", gap: 8 }}>
                  <button onClick={handleCopy} style={{ flex: 1, padding: "10px", borderRadius: 8, border: `1px solid ${copied ? "rgba(74,222,128,0.4)" : C.goldBorder}`, background: copied ? "rgba(74,222,128,0.1)" : C.goldPale, color: copied ? "#4ade80" : C.goldLight, fontSize: 12, fontWeight: 600, cursor: "pointer", fontFamily: "'Outfit',sans-serif", transition: "all .2s" }}>
                    {copied ? "✓ Copiado!" : "Copiar Script"}
                  </button>
                  {canal === "whatsapp" && (
                    <button onClick={handleWpp} style={{ flex: 1, padding: "10px", borderRadius: 8, border: "1px solid rgba(37,211,102,0.3)", background: "rgba(37,211,102,0.1)", color: "#25d366", fontSize: 12, fontWeight: 600, cursor: "pointer", fontFamily: "'Outfit',sans-serif" }}>
                      📲 Abrir no WhatsApp
                    </button>
                  )}
                </div>
              </div>
            )}

            {/* DICAS */}
            {etapa.dicas.length > 0 && (
              <div style={{ background: "rgba(27,58,107,0.12)", border: `1px solid ${C.border}`, borderRadius: 12, padding: "16px 20px", marginBottom: 20 }}>
                <div style={{ fontSize: 11, fontWeight: 700, color: C.gold, letterSpacing: 1, textTransform: "uppercase", marginBottom: 12 }}>Dicas da Etapa</div>
                <div style={{ display: "flex", flexDirection: "column", gap: 8 }}>
                  {etapa.dicas.map((d, i) => (
                    <div key={i} style={{ display: "flex", gap: 10, alignItems: "flex-start" }}>
                      <div style={{ width: 5, height: 5, borderRadius: "50%", background: C.gold, flexShrink: 0, marginTop: 6 }} />
                      <span style={{ fontSize: 12.5, color: C.sub, lineHeight: 1.6 }}>{d}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* OBJEÇÕES */}
            {etapa.objecoes.length > 0 && (
              <div style={{ background: "rgba(27,58,107,0.10)", border: `1px solid ${C.border}`, borderRadius: 12, overflow: "hidden" }}>
                <div style={{ padding: "14px 20px", borderBottom: `1px solid ${C.border}` }}>
                  <div style={{ fontSize: 11, fontWeight: 700, color: "#fb923c", letterSpacing: 1, textTransform: "uppercase" }}>Como Responder Objeções</div>
                </div>
                {etapa.objecoes.map((ob, i) => (
                  <div key={i} style={{ borderBottom: i < etapa.objecoes.length - 1 ? `1px solid ${C.border}` : "none" }}>
                    <button onClick={() => setShowObjecao(showObjecao === i ? null : i)} style={{ width: "100%", padding: "14px 20px", display: "flex", alignItems: "center", justifyContent: "space-between", background: "transparent", border: "none", cursor: "pointer", textAlign: "left" }}>
                      <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
                        <span style={{ fontSize: 13, color: "#fb923c" }}>❝</span>
                        <span style={{ fontSize: 13, fontWeight: 500, color: C.sub }}>{ob.obj}</span>
                      </div>
                      <span style={{ color: C.muted, fontSize: 12, transform: showObjecao === i ? "rotate(180deg)" : "none", transition: "transform .2s" }}>▾</span>
                    </button>
                    {showObjecao === i && (
                      <div style={{ padding: "0 20px 18px", animation: "fadeIn .2s ease" }}>
                        <div style={{ background: "rgba(27,58,107,0.2)", border: `1px solid ${C.border}`, borderRadius: 10, padding: "14px 16px" }}>
                          <div style={{ fontSize: 10, fontWeight: 600, color: TECNICAS[ob.tecnica]?.color, marginBottom: 8, letterSpacing: 0.8, textTransform: "uppercase" }}>
                            Técnica: {TECNICAS[ob.tecnica]?.label}
                          </div>
                          <div style={{ fontSize: 13, color: C.sub, lineHeight: 1.75, whiteSpace: "pre-wrap" }}>{ob.resp}</div>
                        </div>
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}

            {/* NAVEGAÇÃO ENTRE ETAPAS */}
            <div style={{ display: "flex", gap: 10, marginTop: 28 }}>
              <button onClick={() => { setEtapaIdx(Math.max(0, etapaIdx - 1)); setShowObjecao(null); }} disabled={etapaIdx === 0} style={{ flex: 1, padding: "12px", borderRadius: 10, border: `1px solid ${C.border}`, background: "transparent", color: etapaIdx === 0 ? C.muted : C.sub, fontSize: 13, fontWeight: 600, cursor: etapaIdx === 0 ? "not-allowed" : "pointer", fontFamily: "'Outfit',sans-serif", opacity: etapaIdx === 0 ? 0.4 : 1 }}>
                ← Etapa anterior
              </button>
              <button onClick={() => { setEtapaIdx(Math.min(funil.length - 1, etapaIdx + 1)); setShowObjecao(null); }} disabled={etapaIdx === funil.length - 1} style={{ flex: 1, padding: "12px", borderRadius: 10, border: `1px solid ${C.goldBorder}`, background: C.goldPale, color: etapaIdx === funil.length - 1 ? C.muted : C.goldLight, fontSize: 13, fontWeight: 600, cursor: etapaIdx === funil.length - 1 ? "not-allowed" : "pointer", fontFamily: "'Outfit',sans-serif", opacity: etapaIdx === funil.length - 1 ? 0.4 : 1 }}>
                Próxima etapa →
              </button>
            </div>

          </div>
        </div>

        <style>{`@keyframes fadeIn{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}`}</style>
      </div>
    </>
  );
}
